{
  "expo": {
    "name": "PlanPill",
    "slug": "planpill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "planpill",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.planpill.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E62C4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.planpill.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "PlanPill ขอเข้าถึงคลังรูปภาพ เพื่อให้คุณแนบรูปอาหารในไดอารี่ได้",
          "cameraPermission": "PlanPill ขอใช้กล้อง เพื่อให้คุณถ่ายรูปอาหารบันทึกลงไดอารี่ได้",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#2268C8",
          "dark": {
            "backgroundColor": "#2268C8"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2268C8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "420dc915-32a7-45c5-bed5-f94ae686c89a"
      }
    },
    "owner": "jirajira2"
  }
}
